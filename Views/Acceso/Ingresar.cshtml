@model IngresoModelo
@{
    ViewData["Title"] = "Acceso al sistema";
}
<section class="tarjeta-login">
    <div class="icono-login">UT</div>
    <p class="etiqueta-cabecera">UNIVERSO TECNOLÓGICO</p>
    <h1>Iniciar sesión</h1>
    <p class="texto-discreto">Ingresa tus credenciales para administrar el sistema.</p>
    <form asp-controller="Acceso" asp-action="Ingresar" method="post" class="formulario-login">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="mensaje-error"></div>
        <label asp-for="Usuario"></label>
        <input asp-for="Usuario" autocomplete="username" />
        <label asp-for="Contrasena"></label>
        <input asp-for="Contrasena" autocomplete="current-password" />
        <button class="boton boton-primario" type="submit">Ingresar</button>
    </form>
    <small>Las credenciales y los permisos se validan en el servidor.</small>
</section>
